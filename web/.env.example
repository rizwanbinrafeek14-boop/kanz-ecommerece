# Copy this file to .env.local for local development, and add the same variables in Vercel → Project → Settings → Environment Variables.

# Supabase → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
# The "anon" / "publishable" key. Safe to expose: Row Level Security protects the data.
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# The "service_role" / "secret" key. NEVER prefix with NEXT_PUBLIC_. Server-only; used solely to invite staff users.
SUPABASE_SERVICE_ROLE_KEY=

# Public URL of the site (used in emails, sitemap, canonical links)
NEXT_PUBLIC_SITE_URL=https://www.kanzcorner.com

# Optional: Claude API key for automatic catalogue extraction (Admin → Catalogue import → "Extract with Claude").
# Server-only, never prefix with NEXT_PUBLIC_. Leave empty to work with checked extraction files only.
# Cost is roughly US$0.10–0.25 per dense catalogue page (shown live in the admin while extracting).
ANTHROPIC_API_KEY=
